# =============================================================================
# ChronoLegal Platform - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME=ChronoLegal
APP_ENV=development
APP_VERSION=1.0.0
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chronolegal
POSTGRES_USER=chronolegal_user
POSTGRES_PASSWORD=chronolegal_password
DATABASE_URL=postgresql+asyncpg://chronolegal_user:chronolegal_password@postgres:5432/chronolegal
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# VECTOR DATABASE (ChromaDB)
# -----------------------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=legal_documents
CHROMA_PERSIST_DIRECTORY=/data/chromadb

# -----------------------------------------------------------------------------
# CACHE (Redis)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_URL=redis://:redis_password@redis:6379/0
CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# LLM CONFIGURATION
# -----------------------------------------------------------------------------
# Provider: ollama | openai | anthropic | huggingface
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://ollama:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120

# Ollama Settings
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# OpenAI (fallback)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (fallback)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# EMBEDDING MODEL
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_BACKUP_MODEL=nlpaueb/legal-bert-base-uncased
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# -----------------------------------------------------------------------------
# RAG PIPELINE
# -----------------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=128
TOP_K_RETRIEVAL=20
TOP_K_RERANKED=5
SIMILARITY_THRESHOLD=0.6
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# -----------------------------------------------------------------------------
# DATASET
# -----------------------------------------------------------------------------
CHRONOLEGAL_DATA_PATH=/data/chronolegal
PROCESSED_DATA_PATH=/data/processed
EMBEDDINGS_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=500
RATE_LIMIT_PER_DAY=2000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=ChronoLegal
VITE_APP_VERSION=1.0.0
VITE_WS_URL=ws://localhost:8000/ws

# -----------------------------------------------------------------------------
# MONITORING
# -----------------------------------------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=

# -----------------------------------------------------------------------------
# STORAGE
# -----------------------------------------------------------------------------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=50
